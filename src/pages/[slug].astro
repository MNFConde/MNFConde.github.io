---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteLayout from '../layouts/NoteLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const posts = await getCollection('posts');
  return [
    ...notes.map((post) => ({ params: { slug: post.id }, props: { post, isNote: true } })),
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post, isNote: false } })),
  ];
}

const { post, isNote } = Astro.props;
const { Content } = await render(post);
---

{
  isNote ? (
    <NoteLayout frontmatter={post.data}>
      <Content />
    </NoteLayout>
  ) : (
    <BaseLayout title={post.data.title}>
      <main class="note-layout">
        <article class="note-main">
          <header>
            <h1>{post.data.title}</h1>
          </header>
          <Content />
        </article>
      </main>
    </BaseLayout>
  )
}
