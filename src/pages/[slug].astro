---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../layouts/NoteLayout.astro';
import PostLayout from '../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const posts = await getCollection('posts');
  return [
    ...notes.map((post) => ({ params: { slug: post.id }, props: { post, isNote: true } })),
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post, isNote: false } })),
  ];
}

const { post, isNote } = Astro.props;
const { Content, headings } = await render(post);
const Layout = isNote ? NoteLayout : PostLayout;
---

<Layout frontmatter={post.data} headings={headings}>
  <Content />
</Layout>
