---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteLayout from '../layouts/NoteLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  const posts = await getCollection('posts');
  return [
    ...notes.map((post) => ({ params: { slug: post.id }, props: { post, isNote: true } })),
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post, isNote: false } })),
  ];
}

const { post, isNote } = Astro.props;
const { Content } = await render(post);
---

{
  isNote ? (
    <NoteLayout frontmatter={post.data}>
      <Content />
    </NoteLayout>
  ) : (
    <BaseLayout title={post.data.title}>
      <main class="note-layout">
        <article class="note-main">
          <header>
            <h1>{post.data.title}</h1>
            {post.data.original && (
              <div class="orig-controls">
                <button id="orig-toggle" type="button" class="orig-global" aria-pressed="false">
                  对照原文
                </button>
              </div>
            )}
          </header>
          <Content />
        </article>
      </main>
      {post.data.original && (
        <script is:inline>
          // 首帧前恢复读者原文偏好（承暗色防闪白套路）：localStorage orig=on/off 覆盖构建默认
          try {
            const pref = localStorage.getItem('orig');
            if (pref === 'on' || pref === 'off') {
              document.querySelectorAll('.orig-block').forEach((el) => {
                el.classList.toggle('is-open', pref === 'on');
              });
            }
          } catch {}
        </script>
      )}
      {post.data.original && (
        <script>
          import { initOrigEngine } from '../scripts/orig-engine.js';
          initOrigEngine();
        </script>
      )}
    </BaseLayout>
  )
}
