---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const byDate = (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0);
const all = [...(await getCollection('notes')), ...(await getCollection('posts'))].sort(byDate);
const fmt = (d) => d.toISOString().slice(0, 10);
---

<BaseLayout title="归档 · Blog">
  <main class="note-layout">
    <article class="note-main">
      <h1>归档</h1>
      <ul class="post-list archive-list">
        {
          all.map((post) => (
            <li>
              {post.data.date && (
                <time datetime={fmt(post.data.date)}>{fmt(post.data.date)}</time>
              )}
              <a href={`/${post.id}/`}>{post.data.title}</a>
            </li>
          ))
        }
      </ul>
    </article>
  </main>
</BaseLayout>
