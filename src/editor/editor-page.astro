---
// M9 编辑器页：由 editorDev integration 仅在 dev 时 injectRoute（/dev/editor）。
// 本文件在 pages 目录外——build 不产出路由，兑现「生产 build 零新增页面/端点」。
// 样式为 dev 工具专属（is:global + ed- 前缀隔离），不入站点外观令牌体系。
import '../styles/global.css';
---
<div id="editor-app">
  <aside id="ed-sidebar">
    <div class="ed-side-head">
      <strong>notes 文档</strong>
      <button type="button" id="ed-new" title="新建空白文档">新建</button>
    </div>
    <ul id="ed-docs"></ul>
  </aside>
  <main id="ed-main">
    <div id="ed-bar">
      <label class="ed-slug-label">slug <input id="ed-slug" type="text" spellcheck="false" /></label>
      <span id="ed-status"></span>
      <button type="button" id="ed-save">保存 Ctrl+S</button>
    </div>
    <div id="ed-hint"></div>
    <form id="ed-fm"></form>
    <div id="ed-blocks"></div>
    <div id="ed-toolbar">
      <button type="button" data-add="p">+ 段落</button>
      <button type="button" data-add="h2">+ 标题</button>
      <button type="button" data-add="essay">+ 随笔</button>
      <button type="button" data-add="note">+ 边注</button>
      <button type="button" data-add="code">+ 代码</button>
      <button type="button" data-add="image">+ 图片</button>
    </div>
  </main>
  <section id="ed-preview"><div id="ed-preview-mount"></div></section>
</div>

<style is:global>
  /* dev 工具样式：不入 theme.css 令牌体系（M1.5 约束管站点外观，此页不发布） */
  html, body { margin: 0; height: 100%; }
  #editor-app { display: flex; height: 100vh; font: 14px/1.6 system-ui, sans-serif; }
  #ed-sidebar { width: 220px; flex: none; border-right: 1px solid #ccc; overflow-y: auto; padding: 8px; }
  .ed-side-head { display: flex; justify-content: space-between; align-items: center; padding: 4px; }
  #ed-docs { list-style: none; margin: 0; padding: 0; }
  #ed-docs li { padding: 6px 8px; border-radius: 6px; cursor: pointer; }
  #ed-docs li:hover { background: #eee; }
  #ed-docs li.is-active { background: #dbeafe; }
  #ed-docs .ed-doc-slug { display: block; color: #888; font-size: 12px; }
  #ed-main { flex: 1.4; min-width: 360px; overflow-y: auto; padding: 12px 16px 40vh; border-right: 1px solid #ccc; }
  #ed-bar { display: flex; gap: 12px; align-items: center; margin-bottom: 8px; }
  #ed-bar .ed-slug-label { color: #666; }
  #ed-slug { width: 160px; }
  #ed-status { color: #b45309; flex: 1; }
  #ed-hint { white-space: pre-wrap; color: #b91c1c; font-size: 12px; margin: 0 0 8px; }
  #ed-hint:empty { display: none; }
  #ed-blocks { display: flex; flex-direction: column; gap: 10px; }
  .eb { border: 1px solid #ddd; border-radius: 8px; padding: 6px 8px; background: #fafafa; }
  .eb-head { display: flex; gap: 6px; align-items: center; margin-bottom: 4px; font-size: 12px; color: #666; }
  .eb-head .eb-type { font-weight: 600; color: #1d4ed8; }
  .eb-head .eb-id { color: #059669; }
  .eb-head .eb-spacer { flex: 1; }
  .eb textarea, .eb input { width: 100%; border: 1px solid #ddd; border-radius: 4px; padding: 4px 6px; font: inherit; box-sizing: border-box; background: #fff; }
  .eb textarea { resize: none; overflow: hidden; display: block; }
  .eb textarea.eb-code { font-family: ui-monospace, Consolas, monospace; }
  .eb .eb-note-meta input { color: #555; }
  .eb button { font-size: 12px; padding: 2px 8px; }
  #ed-toolbar { position: sticky; bottom: 0; display: flex; gap: 6px; padding: 8px 0; background: linear-gradient(transparent, #fff 40%); }
  #ed-preview { flex: 1.2; min-width: 320px; overflow-y: auto; padding: 16px; }
  #ed-preview-mount:empty::before { content: '预览（切片3 接线）'; color: #aaa; }
</style>

<script>
  import { initEditor } from '../scripts/editor-engine.js';
  initEditor();
</script>
