---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

const { frontmatter, headings, series } = Astro.props;
const tocItems = (headings ?? []).filter((h) => h.depth >= 2); // h1 是文题（header 渲染），导航从节标题起
const hasToc = tocItems.length >= 2; // 单节无导航意义
---

<BaseLayout title={frontmatter.title}>
  <main class="note-layout">
    <article class="note-main">
      <header>
        <h1>{frontmatter.title}</h1>
        {series && (
          <nav class="series-bar" aria-label="系列导航">
            <span class="series-meta">{series.name} · 第 {series.index}/{series.total} 篇</span>
            <span class="series-links">
              {series.prev && <a href={`/${series.prev.id}/`}>← {series.prev.title}</a>}
              {series.next && <a href={`/${series.next.id}/`}>{series.next.title} →</a>}
            </span>
          </nav>
        )}
      </header>
      <slot />
      <footer class="back-to-index">
        <a href="/">← 全部文章</a>
      </footer>
    </article>
  </main>
  <script>
    import { initNotesEngine } from '../scripts/notes-engine.js';
    initNotesEngine();
  </script>
  {hasToc && <TableOfContents items={tocItems} />}
  {hasToc && (
    <script>
      import { initTocEngine } from '../scripts/toc-engine.js';
      initTocEngine();
    </script>
  )}
</BaseLayout>
