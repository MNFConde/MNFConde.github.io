---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

const { frontmatter, headings } = Astro.props;
const tocItems = (headings ?? []).filter((h) => h.depth >= 2); // h1 是文题（header 渲染），导航从节标题起
const hasToc = tocItems.length >= 2; // 单节无导航意义
---

<BaseLayout title={frontmatter.title}>
  <main class="note-layout">
    <article class="note-main">
      <header>
        <h1>{frontmatter.title}</h1>
      </header>
      <slot />
    </article>
  </main>
  <script>
    import { initNotesEngine } from '../scripts/notes-engine.js';
    initNotesEngine();
  </script>
  {hasToc && <TableOfContents items={tocItems} />}
  {hasToc && (
    <script>
      import { initTocEngine } from '../scripts/toc-engine.js';
      initTocEngine();
    </script>
  )}
</BaseLayout>
